# CutStudio v5.0 환경 변수 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# Google Gemini API (AI 요약용)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API (백업 요약용) - 선택사항
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Hugging Face Token (모델 다운로드용)
# 1. https://huggingface.co/settings/tokens 에서 토큰 생성
# 2. pyannote/speaker-diarization-3.1 모델에 대한 액세스 승인 필요
HUGGINGFACE_TOKEN=your_huggingface_token_here

# 임시 파일 저장 경로
TEMP_DIR=/tmp/cutstudio

# 최대 업로드 크기 (MB)
MAX_UPLOAD_SIZE=2000

# 디버그 모드
DEBUG=False